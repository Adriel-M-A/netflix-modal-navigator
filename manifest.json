{
  "manifest_version": 3,
  "name": "Netflix Modal Navigator",
  "version": "1.0.0",
  "description": "Navega de forma fluida entre los modales de detalles de Netflix sin reproducir los videos automáticamente.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}